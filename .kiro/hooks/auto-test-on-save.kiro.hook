{
  "enabled": true,
  "name": "Auto-test on Save",
  "description": "Automatically runs tests for edited TypeScript files in Claudarity-2.0 to catch issues immediately during development",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "Claudarity-2.0/src/**/*.ts",
      "!Claudarity-2.0/src/**/*.test.ts",
      "!Claudarity-2.0/src/**/*.property.test.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run the tests for the edited file using npm test in the Claudarity-2.0 directory. Focus on tests related to the changed file."
  }
}