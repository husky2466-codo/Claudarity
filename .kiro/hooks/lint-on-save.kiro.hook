{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Automatically runs ESLint and fixes auto-fixable issues when TypeScript files are saved in Claudarity-2.0",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "Claudarity-2.0/src/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm run lint` in the Claudarity-2.0 directory and fix any auto-fixable ESLint issues in the edited file"
  }
}