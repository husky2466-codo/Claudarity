{
  "enabled": true,
  "name": "Migration Safety Check",
  "description": "Verifies that database migrations are reversible and have proper test coverage when migrations.ts is modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/migrations.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the changes to migrations.ts and verify:\n1. The migration has a corresponding down/rollback function for reversibility\n2. There are tests covering both up and down migration paths\n3. The migration handles edge cases (empty database, existing data, concurrent access)\n4. Schema changes are backward compatible where possible\n5. Migration version numbering follows the established pattern\n\nIf any issues are found, suggest fixes. Database migrations are critical infrastructure changes."
  }
}