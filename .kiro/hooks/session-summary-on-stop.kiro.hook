{
  "enabled": true,
  "name": "Session Summary on Stop",
  "description": "Automatically logs a session summary including files changed, tests run, and development patterns when the agent stops",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "bash scripts/log-session-summary.sh"
  }
}