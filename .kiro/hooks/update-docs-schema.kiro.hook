{
  "enabled": true,
  "name": "Update Docs on Schema Changes",
  "description": "Automatically prompts to review and update memory-store.md documentation when schema.ts or types.ts files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "Claudarity-2.0/src/database/schema.ts",
      "Claudarity-2.0/src/database/types.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the changes to the schema or type definitions and update the Claudarity-2.0/docs/memory-store.md documentation to reflect any API changes, new types, or schema modifications."
  }
}